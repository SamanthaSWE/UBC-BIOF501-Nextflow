docker.enabled = true

// local development
// process.container = 'depmap-dev'
// production.. docker version MUST be updated manually
process.container = 'ghcr.io/samanthaswe/ubc-biof501-nextflow:v1.3'

params {
    expression_file = 'data/OmicsExpressionTPMLogp1HumanProteinCodingGenes.csv'
    human_protein_atlas_input_file = 'data/proteinatlas.tsv'
    metadata_file = 'data/Model.csv'
}